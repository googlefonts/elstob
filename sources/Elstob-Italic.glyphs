# lookup s_to_longs_alt {
#   sub s by longs.alt;
# } s_to_longs_alt ;

# Helpers for pseudo-ligatures

lookup cv38_s_variants {
  sub s from [ sinsular longs longs.alt2 ] ;
} cv38_s_variants ;

# Lookup 2
lookup ss08_longs_single {
  sub s by longs ;
} ss08_longs_single ;

# Lookup 3
lookup ss08_longs_dflt {
  lookupflag UseMarkFilteringSet @HighLCDiacritics;
  sub @LowerCase_f longs' by s ;
  sub @LowerCase_f @HighLCDiacritics longs' by s ;
  sub [ longs longs.alt2 ]' zerowidthnonjoiner by s;
  sub [ longs longs.alt2 ]' @HighLCDiacritics zerowidthnonjoiner by s;
  ignore sub longs' [ @AllLowerCaseexclf ] ;
  ignore sub longs' @HighLCDiacritics [ @AllLowerCaseexclf ] ;
  sub longs' by s ;
} ss08_longs_dflt ;

# Lookup 4
lookup ss08_longs_ENG {
  lookupflag UseMarkFilteringSet @HighLCDiacritics;
  sub @LowerCase_f longs' by s ;
  sub @LowerCase_f @HighLCDiacritics longs' by s ;
  sub [A E O a e o] longs longs' [b h k t] by s;
  sub [A E O a e o] @HighLCDiacritics longs longs' [b h k t] by s;
  sub @longs_class_1 longs' longs [b h k t] by s;
  sub @longs_class_1 @HighLCDiacritics longs' longs [b h k t] by s;
#  sub [s longs] longs' b by s;
  sub [ longs longs.alt2 ]' [ j zerowidthnonjoiner ] by s;
  sub [ longs longs.alt2 ]' @HighLCDiacritics [ j zerowidthnonjoiner ] by s;
#  sub [ longs longs.alt2 ]' zerowidthnonjoiner by s;
#  sub [ longs longs.alt2 ]' @HighLCDiacritics zerowidthnonjoiner by s;
  ignore sub longs' [ @AllLowerCaseexclf ] ;
  ignore sub longs' @HighLCDiacritics [ @AllLowerCaseexclf ] ;
  sub longs' by s ;
} ss08_longs_ENG ;

# Lookup 5
lookup ss08_longs_FRA {
  lookupflag UseMarkFilteringSet @HighLCDiacritics;
  sub @LowerCase_f longs' by s;
  sub @LowerCase_f @HighLCDiacritics longs' by s;
  sub [ longs longs.alt2 ]' zerowidthnonjoiner by s;
  sub [ longs longs.alt2 ]' @HighLCDiacritics zerowidthnonjoiner by s;
  ignore sub longs' [ @AllLowerCaseexclfbh ] ;
  ignore sub longs' @HighLCDiacritics [ @AllLowerCaseexclfbh ] ;
  sub longs' by s;
} ss08_longs_FRA ;

# lookup 6
lookup ss08_longs_ITA {
  lookupflag UseMarkFilteringSet @HighLCDiacritics;
  sub @LowerCase_f longs' by s;
  sub @LowerCase_f @HighLCDiacritics longs' by s;
#  sub [ longs longs.alt2 ]' b by s;
#  sub [ longs longs.alt2 ]' @HighLCDiacritics b by s;
  sub [ longs longs.alt2 ]' [b agrave egrave igrave ograve ugrave iacute zerowidthnonjoiner] by s;
  sub [ longs longs.alt2 ]' @HighLCDiacritics [b agrave egrave igrave ograve ugrave iacute zerowidthnonjoiner] by s;
#  sub [ longs longs.alt2 ]' @HighLCDiacritics [agrave egrave igrave ograve ugrave iacute] by s;
#  sub [ longs longs.alt2 ]' zerowidthnonjoiner by s;
#  sub [ longs longs.alt2 ]' @HighLCDiacritics zerowidthnonjoiner by s;
  ignore sub [ longs longs.alt2 ]' [ @AllLowerCaseexclf ] ;
  ignore sub [ longs longs.alt2 ]' @HighLCDiacritics [ @AllLowerCaseexclf ] ;
  sub [ longs longs.alt2 ]' by s ;
} ss08_longs_ITA ;

# lookup 7
lookup ss08_longs_ESP {
  lookupflag UseMarkFilteringSet @HighLCDiacritics;
  sub @LowerCase_f longs' by s;
  sub @LowerCase_f @HighLCDiacritics longs' by s;
  sub [ longs longs.alt2 ]' [ b h agrave egrave igrave ograve ugrave iacute zerowidthnonjoiner] by s;
  sub [ longs longs.alt2 ]' @HighLCDiacritics [ b h agrave egrave igrave ograve ugrave iacute zerowidthnonjoiner] by s;
#  sub [ longs longs.alt2 ]' @HighLCDiacritics [agrave egrave igrave ograve ugrave iacute] by s;
#  sub [ longs longs.alt2 ]' [b h] by s;
#  sub [ longs longs.alt2 ]' @HighLCDiacritics [b h] by s;
  sub longs [ longs longs.alt2 ]' i by s;
  sub longs [ longs longs.alt2 ]' @HighLCDiacritics i by s;
#  sub [ longs longs.alt2 ]' zerowidthnonjoiner by s;
#  sub [ longs longs.alt2 ]' @HighLCDiacritics zerowidthnonjoiner by s;
  ignore sub longs' [ @AllLowerCaseexclf ] ;
  ignore sub longs' @HighLCDiacritics [ @AllLowerCaseexclf ] ;
  sub [ longs longs.alt2 ]' by s ;
} ss08_longs_ESP ;

# Lookup 8
lookup f_longs_before_tall {
  sub [ f longs ] by [ f.alt longs.alt2 ] ;
} f_longs_before_tall ;

# Lookup 9
lookup dbl_f_left {
  sub [ f longs ] by [ f.rf longs.rlongs ] ;
} dbl_f_left ;

# Lookup 10
lookup f_tall_right {
  sub [ f longs f.lf longs.llongs ] by [ f.rtall longs.rtall f.lfrtall longs.llongsrtall ] ;
  sub longs.alt2 by longs.rtall ;
} f_tall_right ;

# Lookup 11
lookup f_l_right {
  sub [ f f.lf ] by [ f.rl f.lfrl ] ;
  sub [ f.alt f.alt.lf ] by [ f.rl f.lfrl ] ;
} f_l_right ;

# Lookup 12
lookup dlb_f_right {
  sub [ f f.alt longs ] by [ f.lf f.alt.lf longs.llongs ] ;
} dlb_f_right ;

# Lookup 13
lookup lig_left {
  # when followed by i or j
  sub [ f longs ] by [ longs.rij ] ;
  sub [ f.alt longs.alt2 ] by [ longs.rij ] ;
  sub [ f.lf longs.llongs ] by [ longs.llongsrij ] ;
  sub [ f.alt.lf longs.alt.llongs ] by [ longs.llongsrij ] ;
} lig_left ;

# Lookup 14
lookup lig_right {
  # when preceded by f or longs
  sub [ b h k l lslash thorn thorn.loclENG ] by [ b.lf h.lf k.lf l.lf lslash.lf thorn.lf thorn.loclENG.lf ] ;
} lig_right ;

# Lookup 15
# lookup lig_f_right {
  # when preceded by f
#  sub [ i j ] by [ i.lf j.lf] ;
#} lig_f_right ;

# Lookup 16
lookup lig_longs_right {
  # when preceded by longs
  sub [ i j ] by [ i.llongs j.llongs ] ;
} lig_longs_right ;

# Here are the rules for pseudo-ligatures

# Lookup 17
lookup calt_fligs_0 {
  # Narrower form of f and longs before vowels with diacritics
  sub [ f longs ]' lookup f_longs_before_tall [@HighLCDiacritics eth eth.loclENG l] ;
  sub [ f longs ]' lookup f_longs_before_tall @AllLowerCaseexclf @HighLCDiacritics ;
} calt_fligs_0 ;

# Lookup 18
lookup calt_fligs_1 {
  # Rules for when two f's or longs's come together
  sub [ f longs ]' lookup dbl_f_left [ f f.alt longs longs.alt2 ]' lookup dlb_f_right ;
} calt_fligs_1 ;

# Lookup 19
lookup calt_fligs_2 {
#  sub [ f f.lf f.alt f.alt.lf ]' lookup lig_left [ i j ]' lookup lig_f_right ;
  sub [ longs longs.llongs longs.alt2 ]' lookup lig_left [ i j ]' lookup lig_longs_right ;
  sub [ f f.lf ]' lookup f_tall_right [ b h k lslash thorn thorn.loclENG ]' lookup lig_right ;
  sub [ f f.lf f.alt f.alt.lf ]' lookup f_l_right [ l ]' lookup lig_right ;
  sub [ longs longs.llongs longs.alt2 ]' lookup f_tall_right [ b h k l lslash thorn thorn.loclENG ]' lookup lig_right ;
} calt_fligs_2 ;

lookup std_ligs {
  sub f f i by uniFB03;
  sub f.rf f.alt.lf i by uniFB03 ;
  sub f.rf f.lf i by uniFB03 ;
  sub f f.alt i by uniFB03;
  sub f j by f_j ;
# sub f f l by uniFB04;
# sub f f.alt l by uniFB04;
# sub f f by f_f;
  sub f i by uniFB01;
  sub f.alt i by uniFB01;
# sub f l by uniFB02;
# sub f.alt l by uniFB02;
  sub f eth.loclENG by f_eth.loclENG ;
  sub f.alt eth.loclENG by f_eth.loclENG ;
  sub longs t by longs_t;
  sub longs.llongs t by longs_t.llongs ;
} std_ligs ;
";
name = Prefix;
}
