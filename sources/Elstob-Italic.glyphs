code = "lookup locl_ENG {\012	sub Thorn by Thorn.loclENG;\012	sub eth by eth.loclENG;\012	sub thorn by thorn.loclENG;\012	sub thorncrossed by thorncrossed.loclENG;\012} locl_ENG ;\012\012lookup locl_VIT {\012  sub aacute by aacute.loclVIT ;\012  sub eacute by eacute.loclVIT ;\012  sub iacute by iacute.loclVIT ;\012  sub oacute by oacute.loclVIT ;\012  sub uacute by uacute.loclVIT ;\012  sub yacute by yacute.loclVIT ;\012  sub agrave by agrave.loclVIT ;\012  sub egrave by egrave.loclVIT ;\012  sub igrave by igrave.loclVIT ;\012  sub ograve by ograve.loclVIT ;\012  sub ugrave by ugrave.loclVIT ;\012  sub ygrave by ygrave.loclVIT ;\012  sub acircumflex by acircumflex.loclVIT ;\012  sub acircumflexdotbelow by acircumflexdotbelow.loclVIT ;\012  sub ecircumflex by ecircumflex.loclVIT ;\012  sub ecircumflexdotbelow by ecircumflexdotbelow.loclVIT ;\012  sub ocircumflex by ocircumflex.loclVIT ;\012  sub ocircumflexdotbelow by ocircumflexdotbelow.loclVIT ;\012  sub acutecomb by acutecomb.loclVIT ;\012  sub gravecomb by gravecomb.loclVIT ;\012  sub circumflexcomb by circumflexcomb.loclVIT ;\012} locl_VIT ;\012\012lookup locl_TRK {\012  sub i by idotaccent ;\012} locl_TRK ;\012\012lookup loclROM {\012  sub Scedilla by Scommaaccent;\012  sub scedilla by scommaaccent;\012  sub Tcedilla by Tcommaaccent;\012  sub tcedilla by tcommaaccent;\012} loclROM ;\012\012lookup loclCAT {\012	sub  l' periodcentered' l by ldot;\012	sub  L' periodcentered' L by Ldot;\012} loclCAT ;\012\012lookup ss18_restore_apostrophe {\012  sub quoteright.ss18 by quoteright ;\012  sub quotedblright.ss18 by quotedblright ;\012} ss18_restore_apostrophe ;\012\012lookup smallcaps {\012sub avbar by avbar.sc ;\012sub Germandbls by Germandbls.sc ;\012sub a by a.sc ;\012sub aa by aa.sc ;\012sub aacute by aacute.sc ;\012sub abreve by abreve.sc ;\012sub abreveacute by abreveacute.sc ;\012sub abrevedotbelow by abrevedotbelow.sc ;\012sub abrevegrave by abrevegrave.sc ;\012sub abrevehookabove by abrevehookabove.sc ;\012sub