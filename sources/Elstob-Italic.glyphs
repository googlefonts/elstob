{
code = "lookup calt_01 {\012#  sub f' [@lcVowelsWithDiacritics l eth eth.loclENG] by f.alt ;\012  # non-colliding eth after vowel with diacritic.\012  sub [@HighDiacritics @HighLCDiacritics @AllCapitals ] eth.loclENG' by eth.loclENG.alt;\012  # Insular s followed by insular t must always be substituted with longs.\012  sub sinsular' tinsular by longs;\012  sub longs' [ @HighLCDiacritics l] by longs.alt2 ;\012  # Upper tie 0361 comes in low, medium (for t) and high. Change medium to high, if\012  # necessary, in a separate lookup.\012  # Lower tie (035C) comes in low and high.\012  sub @High_Left_t [doublemacroncomb breveinverteddoublecomb]' by [doublemacroncomb.med breveinverteddoublecomb.med];\012  sub [doublemacroncomb breveinverteddoublecomb]' @High_Right_t by [doublemacroncomb.med breveinverteddoublecomb.med];\012  sub [@Low_Left_lc J Q] doublebrevebelowcomb' by doublebrevebelowcomb.low;\012  sub doublebrevebelowcomb' [@Low_Right_lc J Q] by doublebrevebelowcomb.low;\012  sub [@High_Left_lc @AllCapitals] [doublemacroncomb breveinverteddoublecomb]' by [doublemacroncomb.high breveinverteddoublecomb.high];\012  sub [doublemacroncomb breveinverteddoublecomb]' [@High_Right_lc @AllCapitals] by [doublemacroncomb.high breveinverteddoublecomb.high];\012} calt_01;\012lookup calt_02 {\012  sub [@High_Left_lc @AllCapitals] [doublemacroncomb.med breveinverteddoublecomb.med]' by [doublemacroncomb.high breveinverteddoublecomb.high];\012  sub [doublemacroncomb.med breveinverteddoublecomb.med]' [@High_Right_lc @AllCapitals] by [doublemacroncomb.high breveinverteddoublecomb.high];\012} calt_02;\012lookup calt_03 {\012  # when using r rotunda, restore normal r everywhere but following letters with\012  # rounded right sides.\012  ignore sub @RoundOnRight rrotunda.alt' ;\012  sub rrotunda.alt' by r ;\012} calt_03;\012lookup calt_04 {\012  lookupflag IgnoreMarks;\012  ignore sub [ @AllLowercase @AllCapitals @AllFigures ] p' ;\012  sub p' by p.alt ;\012} calt_04;\012lookup calt_05 {\012  sub [Q q.sc]' @post_Q by [Q.alt q.alt.sc] ;\012} calt_05;\012\012# lookup calt_f_alt ;\012lookup calt_fligs_0 ;\012lookup calt_fligs_1 ;\012lookup calt_fligs_2 ;\012\012# script latn;\012# language ENG;\012# lookup calt_01_1 {\012  # English rules for handling longs: substitute the round form before or after f.\012#   sub @LowerCase_f longs.alt' by s ;\012#   ignore sub longs.alt' @AllLowerCaseexclf ;\012#   sub longs.alt' by s ;\012# } calt_01_1;\012# language FRA;\012# lookup calt_01_2 {\012  # French rules for long s\012#   sub @LowerCase_f longs.alt' by s ;\012#   ignore sub longs.alt' @AllLowerCaseexclfbh ;\012#   sub longs.alt' by s ;\012# } calt_01_2 ;\012";
name = calt;
