{
code = "lookup calt_01 {
#  sub f' [@lcVowelsWithDiacritics l eth eth.loclENG] by f.alt ;
  # non-colliding eth after vowel with diacritic.
  sub [@HighDiacritics @HighLCDiacritics @AllCapitals ] eth.loclENG' by eth.loclENG.alt;
  # Insular s followed by insular t must always be substituted with longs.
  sub sinsular' tinsular by longs;
  sub longs' [ @HighLCDiacritics l] by longs.alt2 ;
  # Upper tie 0361 comes in low, medium (for t) and high. Change medium to high, if
  # necessary, in a separate lookup.
  # Lower tie (035C) comes in low and high.
  sub @High_Left_t [doublemacroncomb breveinverteddoublecomb]' by [doublemacroncomb.med breveinverteddoublecomb.med];
  sub [doublemacroncomb breveinverteddoublecomb]' @High_Right_t by [doublemacroncomb.med breveinverteddoublecomb.med];
  sub [@Low_Left_lc J Q] doublebrevebelowcomb' by doublebrevebelowcomb.low;
  sub doublebrevebelowcomb' [@Low_Right_lc J Q] by doublebrevebelowcomb.low;
  sub [@High_Left_lc @AllCapitals] [doublemacroncomb breveinverteddoublecomb]' by [doublemacroncomb.high breveinverteddoublecomb.high];
  sub [doublemacroncomb breveinverteddoublecomb]' [@High_Right_lc @AllCapitals] by [doublemacroncomb.high breveinverteddoublecomb.high];
} calt_01;
lookup calt_02 {
  sub [@High_Left_lc @AllCapitals] [doublemacroncomb.med breveinverteddoublecomb.med]' by [doublemacroncomb.high breveinverteddoublecomb.high];
  sub [doublemacroncomb.med breveinverteddoublecomb.med]' [@High_Right_lc @AllCapitals] by [doublemacroncomb.high breveinverteddoublecomb.high];
} calt_02;
lookup calt_03 {
  # when using r rotunda, restore normal r everywhere but following letters with
  # rounded right sides.
  ignore sub @RoundOnRight rrotunda.alt' ;
  sub rrotunda.alt' by r ;
} calt_03;
lookup calt_04 {
  lookupflag IgnoreMarks;
  ignore sub [ @AllLowercase @AllCapitals @AllFigures ] p' ;
  sub p' by p.alt ;
} calt_04;
lookup calt_05 {
  sub [Q q.sc]' @post_Q by [Q.alt q.alt.sc] ;
} calt_05;

# lookup calt_f_alt ;
lookup calt_fligs_0 ;
lookup calt_fligs_1 ;
lookup calt_fligs_2 ;

# script latn;
# language ENG;
# lookup calt_01_1 {
  # English rules for handling longs: substitute the round form before or after f.
#   sub @LowerCase_f longs.alt' by s ;
#   ignore sub longs.alt' @AllLowerCaseexclf ;
#   sub longs.alt' by s ;
# } calt_01_1;
# language FRA;
# lookup calt_01_2 {
  # French rules for long s
#   sub @LowerCase_f longs.alt' by s ;
#   ignore sub longs.alt' @AllLowerCaseexclfbh ;
#   sub longs.alt' by s ;
# } calt_01_2 ;
";
tag = calt;
},
