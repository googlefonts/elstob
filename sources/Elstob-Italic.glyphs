code = "# sub longs by longs.alt;
# sub s by longs.alt;

# @class1 = [ dotlessi b c d g h i k l m n p q r s t u v w x y z ] ;
# @class2 = [ dotlessi a b c d e g h i k l m n o p q r s t u v w x y z
#   aacute ae aeacute eacute oacute uacute longs longs.alt2 ] ;

  script DFLT; # Default
    language dflt ; # default
    lookup ss08_longs_single ;
    lookup ss08_longs_dflt ;

  script latn; # Latin
    language dflt ;
    lookup ss08_longs_single ;
    lookup ss08_longs_dflt ;

    language FRA ; # French
    lookup ss08_longs_single ;
    lookup ss08_longs_FRA ;

    language ITA ; # Italian
    lookup ss08_longs_single ;
    lookup ss08_longs_ITA ;

    language ENG ; # English
    lookup ss08_longs_single ;
    lookup ss08_longs_ENG ;

    language ESP ; # Spanish
    lookup ss08_longs_single ;
    lookup ss08_longs_ESP ;
";
