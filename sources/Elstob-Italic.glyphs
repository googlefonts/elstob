tecomb.sc;\012sub circumflexcombhookabovecomb by circumflexcombhookabovecomb.sc;\012sub circumflexcombtildecomb by circumflexcombtildecomb.sc;\012sub gravecomb by gravecomb.sc;\012sub acutecomb by acutecomb.sc;\012sub circumflexcomb by circumflexcomb.sc;\012sub brevecomb by brevecomb.sc;\012sub strokeshortcomb by strokeshortcomb.sc;\012sub slashlongcomb by slashlongcomb.sc;\012sub brevecombtildecomb by brevecombtildecomb.sc;\012sub circumflexcombgravecomb by circumflexcombgravecomb.sc;\012} capstosmallcaps ;\012\012# lookup s_to_longs_alt {\012#   sub s by longs.alt;\012# } s_to_longs_alt ;\012\012# Helpers for pseudo-ligatures\012\012lookup cv38_s_variants {\012  sub s from [ sinsular longs longs.alt2 ] ;\012} cv38_s_variants ;\012\012# Lookup 2\012lookup ss08_longs_single {\012  sub s by longs ;\012} ss08_longs_single ;\012\012# Lookup 3\012lookup ss08_longs_dflt {\012  lookupflag UseMarkFilteringSet @HighLCDiacritics;\012  sub @LowerCase_f longs' by s ;\012  sub @LowerCase_f @HighLCDiacritics longs' by s ;\012  sub [ longs longs.alt2 ]' zerowidthnonjoiner by s;\012  sub [ longs longs.alt2 ]' @HighLCDiacritics zerowidthnonjoiner by s;\012  ignore sub longs' [ @AllLowerCaseexclf ] ;\012  ignore sub longs' @HighLCDiacritics [ @AllLowerCaseexclf ] ;\012  sub longs' by s ;\012} ss08_longs_dflt ;\012\012# Lookup 4\012lookup ss08_longs_ENG {\012  lookupflag UseMarkFilteringSet @HighLCDiacritics;\012  sub @LowerCase_f longs' by s ;\012  sub @LowerCase_f @HighLCDiacritics longs' by s ;\012  sub [A E O a e o] longs longs' [b h k t] by s;\012  sub [A E O a e o] @HighLCDiacritics longs longs' [b h k t] by s;\012  sub @longs_class_1 longs' longs [b h k t] by s;\012  sub @longs_class_1 @HighLCDiacritics longs' longs [b h k t] by s;\012#  sub [s longs] longs' b by s;\012  sub [ longs longs.alt2 ]' [ j zerowidthnonjoiner ] by s;\012  sub [ longs longs.alt2 ]' @HighLCDiacritics [ j zerowidthnonjoiner ] by s;\012#  sub [ longs longs.alt2 ]' zerowidthnonjoiner by s;\012#  sub [ longs longs.alt2 ]' @HighLCDiacritics zerowidthnonjoiner by s;\012  ignore sub longs' [ @AllLowerCaseexclf ] ;\012  ignore sub longs' @HighLCDiacritics [ @AllLowerCaseexclf ] ;\012  sub longs' by s ;\012} ss08_longs_ENG ;\012\012# Lookup 5\012lookup ss08_longs_FRA {\012  lookupflag UseMarkFilteringSet @HighLCDiacritics;\012  sub @LowerCase_f longs' by s;\012  sub @LowerCase_f @HighLCDiacritics longs' by s;\012  sub [ longs longs.alt2 ]' zerowidthnonjoiner by s;\012  sub [ longs longs.alt2 ]' @HighLCDiacritics zerowidthnonjoiner by s;\012  ignore sub longs' [ @AllLowerCaseexclfbh ] ;\012  ignore sub longs' @HighLCDiacritics [ @AllLowerCaseexclfbh ] ;\012  sub longs' by s;\012} ss08_longs_FRA ;\012\012# lookup 6\012lookup ss08_longs_ITA {\012  lookupflag UseMarkFilteringSet @HighLCDiacritics;\012  sub @LowerCase_f longs' by s;\012  sub @LowerCase_f @HighLCDiacritics longs' by s;\012#  sub [ longs longs.alt2 ]' b by s;\012#  sub [ longs longs.alt2 ]' @HighLCDiacritics b by s;\012  sub [ longs longs.alt2 ]' [b agrave egrave igrave ograve ugrave iacute zerowidthnonjoiner] by s;\012  sub [ longs longs.alt2 ]' @HighLCDiacritics [b agrave egrave igrave ograve ugrave iacute zerowidthnonjoiner] by s;\012#  sub [ longs longs.alt2 ]' @HighLCDiacritics [agrave egrave igrave ograve ugrave iacute] by s;\012#  sub [ longs longs.alt2 ]' zerowidthnonjoiner by s;\012#  sub [ longs longs.alt2 ]' @HighLCDiacritics zerowidthnonjoiner by s;\012  ignore sub [ longs longs.alt2 ]' [ @AllLowerCaseexclf ] ;\012  ignore sub [ longs longs.alt2 ]' @HighLCDiacritics [ @AllLowerCaseexclf ] ;\012  sub [ longs longs.alt2 ]' by s ;\012} ss08_longs_ITA ;\012\012# lookup 7\012lookup ss08_longs_ESP {\012  lookupflag UseMarkFilteringSet @HighLCDiacritics;\012  sub @LowerCase_f longs' by s;\012  sub @LowerCase_f @HighLCDiacritics longs' by s;\012  sub [ longs longs.alt2 ]' [ b h agrave egrave igrave ograve ugrave iacute zerowidthnonjoiner] by s;\012  sub [ longs longs.alt2 ]' @HighLCDiacritics [ b h agrave egrave igrave ograve ugrave iacute zerowidthnonjoiner] by s;\012#  sub [ longs longs.alt2 ]' @HighLCDiacritics [agrave egrave igrave ograve ugrave iacute] by s;\012#  sub [ longs longs.alt2 ]' [b h] by s;\012#  sub [ longs longs.alt2 ]' @HighLCDiacritics [b h] by s;\012  sub longs [ longs longs.alt2 ]' i by s;\012  sub longs [ longs longs.alt2 ]' @HighLCDiacritics i by s;\012#  sub [ longs longs.alt2 ]' zerowidthnonjoiner by s;\012#  sub [ longs longs.alt2 ]' @HighLCDiacritics zerowidthnonjoiner by s;\012  ignore sub longs' [ @AllLowerCaseexclf ] ;\012  ignore sub longs' @HighLCDiacritics [ @AllLowerCaseexclf ] ;\012  sub [ longs longs.alt2 ]' by s ;\012} ss08_longs_ESP ;\012\012# Lookup 8\012lookup f_longs_before_tall {\012  sub [ f longs ] by [ f.alt longs.alt2 ] ;\012} f_longs_before_tall ;\012\012# Lookup 9\012lookup dbl_f_left {\012  sub [ f longs ] by [ f.rf longs.rlongs ] ;\012} dbl_f_left ;\012\012# Lookup 10\012lookup f_tall_right {\012  sub [ f longs f.lf longs.llongs ] by [ f.rtall longs.rtall f.lfrtall longs.llongsrtall ] ;\012  sub longs.alt2 by longs.rtall ;\012} f_tall_right ;\012\012# Lookup 11\012lookup f_l_right {\012  sub [ f f.lf ] by [ f.rl f.lfrl ] ;\012  sub [ f.alt f.alt.lf ] by [ f.rl f.lfrl ] ;\012} f_l_right ;\012\012# Lookup 12\012lookup dlb_f_right {\012  sub [ f f.alt longs ] by [ f.lf f.alt.lf longs.llongs ] ;\012} dlb_f_right ;\012\012# Lookup 13\012lookup lig_left {\012  # when followed by i or j\012  sub [ f longs ] by [ longs.rij ] ;\012  sub [ f.alt longs.alt2 ] by [ longs.rij ] ;\012  sub [ f.lf longs.llongs ] by [ longs.llongsrij ] ;\012  sub [ f.alt.lf longs.alt.llongs ] by [ longs.llongsrij ] ;\012} lig_left ;\012\012# Lookup 14\012lookup lig_right {\012  # when preceded by f or longs\012  sub [ b h k l lslash thorn thorn.loclENG ] by [ b.lf h.lf k.lf l.lf lslash.lf thorn.lf thorn.loclENG.lf ] ;\012} lig_right ;\012\012# Lookup 15\012# lookup lig_f_right {\012  # when preceded by f\012#  sub [ i j ] by [ i.lf j.lf] ;\012#} lig_f_right ;\012\012# Lookup 16\012lookup lig_longs_right {\012  # when preceded by longs\012  sub [ i j ] by [ i.llongs j.llongs ] ;\012} lig_longs_right ;\012\012# Here are the rules for pseudo-ligatures\012\012# Lookup 17\012lookup calt_fligs_0 {\012  # Narrower form of f and longs before vowels with diacritics\012  sub [ f longs ]' lookup f_longs_before_tall [@HighLCDiacritics eth eth.loclENG l] ;\012  sub [ f longs ]' lookup f_longs_before_tall @AllLowerCaseexclf @HighLCDiacritics ;\012} calt_fligs_0 ;\012\012# Lookup 18\012lookup calt_fligs_1 {\012  # Rules for when two f's or longs's come together\012  sub [ f longs ]' lookup dbl_f_left [ f f.alt longs longs.alt2 ]' lookup dlb_f_right ;\012} calt_fligs_1 ;\012\012# Lookup 19\012lookup calt_fligs_2 {\012#  sub [ f f.lf f.alt f.alt.lf ]' lookup lig_left [ i j ]' lookup lig_f_right ;\012  sub [ longs longs.llongs longs.alt2 ]' lookup lig_left [ i j ]' lookup lig_longs_right ;\012  sub [ f f.lf ]' lookup f_tall_right [ b h k lslash thorn thorn.loclENG ]' lookup lig_right ;\012  sub [ f f.lf f.alt f.alt.lf ]' lookup f_l_right [ l ]' lookup lig_right ;\012  sub [ longs longs.llongs longs.alt2 ]' lookup f_tall_right [ b h k l lslash thorn thorn.loclENG ]' lookup lig_right ;\012} calt_fligs_2 ;\012\012lookup std_ligs {\012  sub f f i by uniFB03;\012  sub f.rf f.alt.lf i by uniFB03 ;\012  sub f.rf f.lf i by uniFB03 ;\012  sub f f.alt i by uniFB03;\012  sub f j by f_j ;\012# sub f f l by uniFB04;\012# sub f f.alt l by uniFB04;\012# sub f f by f_f;\012  sub f i by uniFB01;\012  sub f.alt i by uniFB01;\012# sub f l by uniFB02;\012# sub f.alt l by uniFB02;\012  sub f eth.loclENG by f_eth.loclENG ;\012  sub f.alt eth.loclENG by f_eth.loclENG ;\012  sub longs t by longs_t;\012  sub longs.llongs t by longs_t.llongs ;\012} std_ligs ;\012";
name = Prefix;
}
);
