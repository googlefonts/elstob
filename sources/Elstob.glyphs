code = "@lowdiacplus = [graphemejoinercomb @LowDiacritics];
lookup ccmp_01 {
  sub [i j iogonek]' @HighDiacritics by [dotlessi jdotless dotlessiogonek];
  sub [i j iogonek]' @lowdiacplus @HighLCDiacritics by [dotlessi jdotless dotlessiogonek];
  sub [i j iogonek]' @lowdiacplus @lowdiacplus @HighLCDiacritics by [dotlessi jdotless dotlessiogonek];
  sub [ doublemacroncomb breveinverteddoublecomb ] [ i j ]' by [dotlessi jdotless];
#  sub iogonek' @HighLCDiacritics by dotlessiogonek;
} ccmp_01;
# These are ligatures for the rhotic hook. For the rationale for handling it here rather than liga
# or rlig, see https://typedrawers.com/discussion/3242/modifier-letter-rhotic-hook/p1
lookup ccmp_02 {
  sub schwa rhotichookmod by schwahook;
  sub eopenreversed rhotichookmod by eopenreversedhook;
  sub a rhotichookmod by uni006102DE;
  sub ramshorn rhotichookmod by uni026402DE;
  sub OEsmall rhotichookmod by uni027602DE;
  sub ae rhotichookmod by uni00E602DE;
  sub e rhotichookmod by uni006502DE;
  sub eopen rhotichookmod by uni025B02DE;
  sub oe rhotichookmod by uni015302DE;
  sub ubar rhotichookmod by uni028902DE;
  sub Ysmall rhotichookmod by uni028F02DE;
  sub y rhotichookmod by uni007902DE;
  sub ereversed rhotichookmod by uni025802DE;
  sub obarred rhotichookmod by uni027502DE;
  sub istroke rhotichookmod by uni026802DE;
} ccmp_02;

lookup grek_dieresisCapInsertion {
#	script grek;
	sub [Alphatonos Epsilontonos Omicrontonos Upsilontonos] Iota' by Iotadieresis;
	sub [Alphatonos Epsilontonos Etatonos Omicrontonos Omegatonos] Upsilon' by Upsilondieresis;
	sub [alphatonos.sc epsilontonos.sc omicrontonos.sc upsilontonos.sc] iota.sc' by iotadieresis.sc;
	sub [alphatonos.sc epsilontonos.sc etatonos.sc omicrontonos.sc omegatonos.sc] upsilon.sc' by upsilondieresis.sc;
} grek_dieresisCapInsertion;

lookup grek_tonosCap {
script grek;
  language ELL ;
	# tonos supression within a word
	sub @grekCapsTonos' @grekSmcp by @grekCapsTonosless;
	sub @grekCaps @grekCapsTonos' by @grekCapsTonosless;
	sub @grekCapsTonos' @grekCaps by @grekCapsTonosless;
} grek_tonosCap;

lookup grek_ComplexDiacritics {
# script grek;
  sub psili varia by psilivaria ;
  sub psili oxia by psilioxia ;
  sub psili perispomenicomb by psiliperispomeni ;
  sub dasia varia by dasiavaria ;
  sub dasia oxia by dasiaoxia ;
  sub psili perispomenicomb by psiliperispomeni ;
  sub dasia perispomenicomb by dasiaperispomeni ;
  sub dieresiscomb varia by dialytikavaria ;
  sub dieresiscomb oxia by dialytikatonoscomb ;
  sub dieresiscomb perispomenicomb by dialytikaperispomeni ;
} grek_ComplexDiacritics ;

