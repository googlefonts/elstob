{
code = "lookup calt_01 {\012#  lookupflag UseMarkFilteringSet @HighLCDiacritics;\012  # sub [ f longs ]' [@lcVowelsWithDiacritics eth eth.loclENG l] by [ f.alt longs.alt2 ];\012  # sub [ f longs ]' lookup f_longs_before_tall [@lcVowelsWithDiacritics eth eth.loclENG l] ;\012  # Avoid collision of diacritics with eth\012  sub [@HighLCDiacritics @lcVowelsWithDiacritics f f.alt] eth.loclENG' by eth.loclENG.alt;\012  # Insular s followed by insular t must always be substituted with longs.\012  sub sinsular' tinsular by longs;\012  # Upper tie 0361 and overscore 0305 come in low, medium (for t) and high. Change medium to high, if\012  # necessary, in a separate lookup.\012  # Lower tie (035C) comes in low and high.\012  sub @High_Left_t [doublemacroncomb breveinverteddoublecomb]' by [doublemacroncomb.med breveinverteddoublecomb.med];\012  sub [doublemacroncomb breveinverteddoublecomb]' @High_Right_t by [doublemacroncomb.med breveinverteddoublecomb.med];\012  sub [@Low_Left_lc J Q] doublebrevebelowcomb' by doublebrevebelowcomb.low;\012  sub doublebrevebelowcomb' [@Low_Right_lc J Q] by doublebrevebelowcomb.low;\012  sub [@High_Left_lc @Uppercase] [overlinecomb breveinverteddoublecomb]' by [doublemacroncomb.high breveinverteddoublecomb.high];\012  sub [doublemacroncomb breveinverteddoublecomb]' [@High_Right_lc @Uppercase] by [doublemacroncomb.high breveinverteddoublecomb.high];\012} calt_01;\012lookup calt_02 {\012#  sub @High_Left_lc uni0361.med' by uni0361.high;\012#  sub uni0361.med' @High_Right_lc by uni0361.high;\012  sub [@High_Left_lc @Uppercase] [doublemacroncomb.med breveinverteddoublecomb.med]' by [doublemacroncomb.high breveinverteddoublecomb.high];\012  sub [doublemacroncomb.med breveinverteddoublecomb.med]' [@High_Right_lc @Uppercase] by [doublemacroncomb.high breveinverteddoublecomb.high];\012} calt_02;\012lookup calt_03 {\012  ignore sub @RoundOnRight rrotunda.alt' ;\012  sub rrotunda.alt' by r ;\012} calt_03;\012lookup calt_04 {\012  sub [E AE OE e.sc ae.sc oe.sc] ogonekcomb' by ogonekcomb.case.alt;\012} calt_04;\012lookup calt_05 {\012  sub [Q q.sc]' @post_Q by [Q.alt q.alt.sc] ;\012}calt_05;\012\012# lookup calt_f_alt ;\012lookup calt_fligs_0 ;\012lookup calt_fligs_1 ;\012lookup calt_fligs_2 ;\012\012# script latn;\012# language ENG;\012#  lookup calt_01_1 {\012  # English rules for handling longs: substitute the round form before or after f.\012#  sub @LowerCase_f longs.alt' by s ;\012#  ignore sub longs.alt' @AllLowerCaseexclf ;\012#  sub longs.alt' by s ;\012# } calt_01_1;\012# language FRA;\012# lookup calt_01_2 {\012  # French rules for long s\012#  sub @LowerCase_f longs.alt' by s ;\012#  ignore sub longs.alt' @AllLowerCaseexclfbh ;\012#  sub longs.alt' by s ;\012# } calt_01_2 ;\012";
name = calt;
