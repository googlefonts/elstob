{
code = "lookup calt_01 {
#  lookupflag UseMarkFilteringSet @HighLCDiacritics;
  # sub [ f longs ]' [@lcVowelsWithDiacritics eth eth.loclENG l] by [ f.alt longs.alt2 ];
  # sub [ f longs ]' lookup f_longs_before_tall [@lcVowelsWithDiacritics eth eth.loclENG l] ;
  # Avoid collision of diacritics with eth
  sub [@HighLCDiacritics @lcVowelsWithDiacritics f f.alt] eth.loclENG' by eth.loclENG.alt;
  # Insular s followed by insular t must always be substituted with longs.
  sub sinsular' tinsular by longs;
  # Upper tie 0361 and overscore 0305 come in low, medium (for t) and high. Change medium to high, if
  # necessary, in a separate lookup.
  # Lower tie (035C) comes in low and high.
  sub @High_Left_t [doublemacroncomb breveinverteddoublecomb]' by [doublemacroncomb.med breveinverteddoublecomb.med];
  sub [doublemacroncomb breveinverteddoublecomb]' @High_Right_t by [doublemacroncomb.med breveinverteddoublecomb.med];
  sub [@Low_Left_lc J Q] doublebrevebelowcomb' by doublebrevebelowcomb.low;
  sub doublebrevebelowcomb' [@Low_Right_lc J Q] by doublebrevebelowcomb.low;
  sub [@High_Left_lc @Uppercase] [overlinecomb breveinverteddoublecomb]' by [doublemacroncomb.high breveinverteddoublecomb.high];
  sub [doublemacroncomb breveinverteddoublecomb]' [@High_Right_lc @Uppercase] by [doublemacroncomb.high breveinverteddoublecomb.high];
} calt_01;
lookup calt_02 {
#  sub @High_Left_lc uni0361.med' by uni0361.high;
#  sub uni0361.med' @High_Right_lc by uni0361.high;
  sub [@High_Left_lc @Uppercase] [doublemacroncomb.med breveinverteddoublecomb.med]' by [doublemacroncomb.high breveinverteddoublecomb.high];
  sub [doublemacroncomb.med breveinverteddoublecomb.med]' [@High_Right_lc @Uppercase] by [doublemacroncomb.high breveinverteddoublecomb.high];
} calt_02;
lookup calt_03 {
  ignore sub @RoundOnRight rrotunda.alt' ;
  sub rrotunda.alt' by r ;
} calt_03;
lookup calt_04 {
  sub [E AE OE e.sc ae.sc oe.sc] ogonekcomb' by ogonekcomb.case.alt;
} calt_04;
lookup calt_05 {
  sub [Q q.sc]' @post_Q by [Q.alt q.alt.sc] ;
}calt_05;

# lookup calt_f_alt ;
lookup calt_fligs_0 ;
lookup calt_fligs_1 ;
lookup calt_fligs_2 ;

# script latn;
# language ENG;
#  lookup calt_01_1 {
  # English rules for handling longs: substitute the round form before or after f.
#  sub @LowerCase_f longs.alt' by s ;
#  ignore sub longs.alt' @AllLowerCaseexclf ;
#  sub longs.alt' by s ;
# } calt_01_1;
# language FRA;
# lookup calt_01_2 {
  # French rules for long s
#  sub @LowerCase_f longs.alt' by s ;
#  ignore sub longs.alt' @AllLowerCaseexclfbh ;
#  sub longs.alt' by s ;
# } calt_01_2 ;
";
tag = calt;
