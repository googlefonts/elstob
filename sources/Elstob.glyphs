\012#lookup 5\012lookup cv38_s_variants {\012  sub s from [ sinsular longs longs.alt2 ] ;\012} cv38_s_variants ;\012\012# Lookup 6\012lookup ss08_longs_single {\012  sub s by longs ;\012} ss08_longs_single ;\012\012# Lookup 7\012lookup ss08_longs_dflt {\012  lookupflag UseMarkFilteringSet @HighLCDiacritics;\012  sub @LowerCase_f longs' by s ;\012  sub @LowerCase_f @HighLCDiacritics longs' by s ;\012  sub [ longs longs.alt2 ]' zerowidthnonjoiner by s;\012  sub [ longs longs.alt2 ]' @HighLCDiacritics zerowidthnonjoiner by s;\012  ignore sub longs' [ @AllLowerCaseexclf ] ;\012  ignore sub longs' @HighLCDiacritics [ @AllLowerCaseexclf ] ;\012  sub longs' by s ;\012} ss08_longs_dflt ;\012\012# Lookup 8\012lookup ss08_longs_ENG {\012  lookupflag UseMarkFilteringSet @HighLCDiacritics;\012  sub @LowerCase_f longs' by s ;\012  sub @LowerCase_f @HighLCDiacritics longs' by s ;\012  sub [A E O a e o] longs longs' [b h k t] by s;\012  sub [A E O a e o] @HighLCDiacritics longs longs' [b h k t] by s;\012  sub @longs_class_1 longs' longs [b h k t] by s;\012  sub @longs_class_1 @HighLCDiacritics longs' longs [b h k t] by s;\012#  sub [s longs] longs' b by s;\012  sub [ longs longs.alt2 ]' [ j zerowidthnonjoiner ] by s;\012  sub [ longs longs.alt2 ]' @HighLCDiacritics [ j zerowidthnonjoiner ] by s;\012#  sub [ longs longs.alt2 ]' zerowidthnonjoiner by s;\012#  sub [ longs longs.alt2 ]' @HighLCDiacritics zerowidthnonjoiner by s;\012  ignore sub longs' [ @AllLowerCaseexclf ] ;\012  ignore sub longs' @HighLCDiacritics [ @AllLowerCaseexclf ] ;\012  sub longs' by s ;\012} ss08_longs_ENG ;\012\012# Lookup 5\012lookup ss08_longs_FRA {\012  lookupflag UseMarkFilteringSet @HighLCDiacritics;\012  sub @LowerCase_f longs' by s;\012  sub @LowerCase_f @HighLCDiacritics longs' by s;\012  sub [ longs longs.alt2 ]' zerowidthnonjoiner by s;\012  sub [ longs longs.alt2 ]' @HighLCDiacritics zerowidthnonjoiner by s;\012  ignore sub longs' [ @AllLowerCaseexclfbh ] ;\012  ignore sub longs' @HighLCDiacritics [ @AllLowerCaseexclfbh ] ;\012  sub longs' by s;\012} ss08_longs_FRA ;\012\012# lookup 6\012lookup ss08_longs_ITA {\012  lookupflag UseMarkFilteringSet @HighLCDiacritics;\012  sub @LowerCase_f longs' by s;\012  sub @LowerCase_f @HighLCDiacritics longs' by s;\012#  sub [ longs longs.alt2 ]' b by s;\012#  sub [ longs longs.alt2 ]' @HighLCDiacritics b by s;\012  sub [ longs longs.alt2 ]' [b agrave egrave igrave ograve ugrave iacute zerowidthnonjoiner] by s;\012  sub [ longs longs.alt2 ]' @HighLCDiacritics [b agrave egrave igrave ograve ugrave iacute zerowidthnonjoiner] by s;\012#  sub [ longs longs.alt2 ]' @HighLCDiacritics [agrave egrave igrave ograve ugrave iacute] by s;\012#  sub [ longs longs.alt2 ]' zerowidthnonjoiner by s;\012#  sub [ longs longs.alt2 ]' @HighLCDiacritics zerowidthnonjoiner by s;\012  ignore sub [ longs longs.alt2 ]' [ @AllLowerCaseexclf ] ;\012  ignore sub [ longs longs.alt2 ]' @HighLCDiacritics [ @AllLowerCaseexclf ] ;\012  sub [ longs longs.alt2 ]' by s ;\012} ss08_longs_ITA ;\012\012# lookup 7\012lookup ss08_longs_ESP {\012  lookupflag UseMarkFilteringSet @HighLCDiacritics;\012  sub @LowerCase_f longs' by s;\012  sub @LowerCase_f @HighLCDiacritics longs' by s;\012  sub [ longs longs.alt2 ]' [ b h agrave egrave igrave ograve ugrave iacute zerowidthnonjoiner] by s;\012  sub [ longs longs.alt2 ]' @HighLCDiacritics [ b h agrave egrave igrave ograve ugrave iacute zerowidthnonjoiner] by s;\012#  sub [ longs longs.alt2 ]' @HighLCDiacritics [agrave egrave igrave ograve ugrave iacute] by s;\012#  sub [ longs longs.alt2 ]' [b h] by s;\012#  sub [ longs longs.alt2 ]' @HighLCDiacritics [b h] by s;\012  sub longs [ longs longs.alt2 ]' i by s;\012  sub longs [ longs longs.alt2 ]' @HighLCDiacritics i by s;\012#  sub [ longs longs.alt2 ]' zerowidthnonjoiner by s;\012#  sub [ longs longs.alt2 ]' @HighLCDiacritics zerowidthnonjoiner by s;\012  ignore sub longs' [ @AllLowerCaseexclf ] ;\012  ignore sub longs' @HighLCDiacritics [ @AllLowerCaseexclf ] ;\012  sub [ longs longs.alt2 ]' by s ;\012} ss08_longs_ESP ;\012\012# Lookup 8\012lookup f_longs_before_tall {\012  sub [ f longs ] by [ f.alt longs.alt2 ] ;\012} f_longs_before_tall ;\012\012# Lookup 9\012lookup dbl_f_left {\012  sub [ f longs ] by [ f.rf longs.rlongs ] ;\012} dbl_f_left ;\012\012# Lookup 10\012lookup f_tall_right {\012  sub [ f longs f.lf longs.llongs ] by [ f.rtall longs.rtall f.lfrtall longs.llongsrtall ] ;\012  sub longs.alt2 by longs.rtall ;\012} f_tall_right ;\012\012# Lookup 11\012lookup f_l_right {\012  sub [ f f.lf ] by [ f.rl f.lfrl ] ;\012  sub [ f.alt f.alt.lf ] by [ f.rl f.lfrl ] ;\012} f_l_right ;\012\012# Lookup 12\012lookup dlb_f_right {\012  sub [ f f.alt longs ] by [ f.lf f.alt.lf longs.llongs ] ;\012} dlb_f_right ;\012\012# Lookup 13\012lookup lig_left {\012  # when followed by i or j\012  sub [ f longs ] by [ f.rij longs.rij ] ;\012  sub [ f.alt longs.alt2 ] by [ f.rij longs.rij ] ;\012  sub [ f.lf longs.llongs ] by [ f.lfrij longs.llongsrij ] ;\012  sub [ f.alt.lf longs.alt.llongs ] by [ f.lfrij longs.llongsrij ] ;\012} lig_left ;\012\012# Lookup 14\012lookup lig_right {\012  # when preceded by f or longs\012  sub [ b h k l lslash thorn thorn.loclENG ] by [ b.lf h.lf k.lf l.lf lslash.lf thorn.lf thorn.loclENG.lf ] ;\012} lig_right ;\012\012# Lookup 15\012lookup lig_f_right {\012  # when preceded by f\012  sub [ i j ] by [ i.lf j.lf] ;\012} lig_f_right ;\012\012# Lookup 16\012lookup lig_longs_right {\012  # when preceded by longs\012  sub [ i j ] by [ i.llongs j.llongs ] ;\012} lig_longs_right ;\012\012# Here are the rules for pseudo-ligatures\012\012# Lookup 17\012lookup calt_fligs_0 {\012  # Narrower form of f and longs before vowels with diacritics\012  sub [ f longs ]' lookup f_longs_before_tall [@lcVowelsWithDiacritics eth eth.loclENG l] ;\012  sub [ f longs ]' lookup f_longs_before_tall @AllLowerCaseexclf @HighLCDiacritics ;\012} calt_fligs_0 ;\012\012# Lookup 18\012lookup calt_fligs_1 {\012  # Rules for when two f's or longs's come together\012  sub [ f longs ]' lookup dbl_f_left [ f f.alt longs longs.alt2 ]' lookup dlb_f_right ;\012} calt_fligs_1 ;\012\012# Lookup 19\012lookup calt_fligs_2 {\012ignore sub [ f f.lf f.alt f.alt.lf ]' [ i j ]' @HighLCDiacritics ;\012  sub [ f f.lf f.alt f.alt.lf ]' lookup lig_left [ i j ]' lookup lig_f_right ;\012  sub [ longs longs.llongs longs.alt2 ]' lookup lig_left [ i j ]' lookup lig_longs_right ;\012  sub [ f f.lf ]' lookup f_tall_right [ b h k thorn thorn.loclENG lslash ]' lookup lig_right ;\012  sub [ f f.lf f.alt f.alt.lf ]' lookup f_l_right [ l ]' lookup lig_right ;\012  sub [ longs longs.llongs longs.alt2 ]' lookup f_tall_right [ b h k l lslash thorn thorn.loclENG ]' lookup lig_right ;\012} calt_fligs_2 ;\012\012lookup std_ligs {\012#  sub f f i by f_f_i;\012#  sub f f.alt i by f_f_i;\012#  sub f f l by f_f_l;\012#  sub f f.alt l by f_f_l;\012  sub f odieresis by f_odieresis;\012  sub f.alt odieresis by f_odieresis;\012  sub f udieresis by f_udieresis;\012  sub f.alt udieresis by f_udieresis;\012#  sub f f by f_f;\012#  sub f i by fi;\012#  sub f.alt i by fi;\012#  sub f l by fl;\012#  sub f.alt l by fl;\012  sub longs t by longs_t;\012  sub longs.llongs t by longs_t;\012} std_ligs ;\012";
name = Prefix;
}
);
features = (
{
automatic = 1;
code = "feature frac;\012feature sups;\012feature subs;\012feature ordn;\012feature tnum;\012feature onum;\012feature pnum;\012feature lnum;\012feature zero;\012feature case;\012feature ss01;\012feature ss02;\012feature ss08;\012feature ss09;\012feature ss12;\012feature ss13;\012feature ss14;\012feature ss15;\012feature ss16;\012feature ss18;\012feature cv07;\012feature cv08;\012feature cv11;\012feature cv12;\012feature cv13;\012feature cv14;\012feature cv18;\012feature cv35;\012feature cv36;\012feature cv37;\012feature cv38;\012feature cv39;\012feature cv40;\012feature cv69;\012feature cv76;\012feature calt;\012feature sinf;\012";
name = aalt;
},
{
code = "lookup ccmp_01 {\012  sub [i j]' @CombDiacritics by [dotlessi jdotless];\012  sub [i j]' @LowDiacritics @HighLCDiacritics by [dotlessi jdotless];\012  sub [ doublemacroncomb breveinverteddoublecomb ] [ i j ]' by [dotlessi jdotless];\012  sub iogonek' @HighLCDiacritics by dotlessiogonek;\012} ccmp_01;\012# These are ligatures for the rhotic hook. For the rationale for handling it here rather than liga\012# or rlig, see https://typedrawers.com/discussion/3242/modifier-letter-rhotic-hook/p1\012lookup ccmp_02 {\012  sub schwa rhotichookmod by schwahook;\012  sub eopenreversed rhotichookmod by eopenreversedhook;\012  sub a rhotichookmod by uni006102DE;\012  sub ramshorn rhotichookmod by uni026402DE;\012  sub OEsmall rhotichookmod by uni027602DE;\012  sub ae rhotichookmod by uni00E602DE;\012  sub e rhotichookmod by uni006502DE;\012  sub eopen rhotichookmod by uni025B02DE;\012  sub oe rhotichookmod by uni015302DE;\012  sub ubar rhotichookmod by uni028902DE;\012  sub Ysmall rhotichookmod by uni028F02DE;\012  sub y rhotichookmod by uni007902DE;\012  sub ereversed rhotichookmod by uni025802DE;\012  sub obarred rhotichookmod by uni027502DE;\012  sub istroke rhotichookmod by uni026802DE;\012} ccmp_02;\012";
name = ccmp;
},
{
code = "\012script latn;\012  language ENG;\012  lookup locl_ENG ;\012\012  language VIT;\012  lookup locl_VIT;";
name = locl;
},
{
code = "#script latn;\012# sub one slash eight by oneeighth;\012sub one slash four by onequarter;\012sub one slash two by onehalf;\012# sub five slash eight by fiveeighths;\012sub three slash four by threequarters;\012# sub one slash three by onethird;\012";
name = frac;
